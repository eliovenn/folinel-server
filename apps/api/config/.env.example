# 复制所需配置到同目录的 .env.development；不要提交真实密码。
NODE_ENV=development
PORT=3000
# 直连留空；反向代理部署时填写可信代理 IP/CIDR，逗号分隔。
TRUST_PROXY=

# 使用密码管理器生成至少 32 字符的随机密钥；不要将真实值提交或输出到日志。
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:5173

# Supabase：在 Connect 面板选择 Session pooler，完整复制连接串后替换密码。
# 这里填写 PostgreSQL URI，用户名包含项目引用；不要填 Supabase HTTP API 密钥。
# 连接串不要带 ?sslmode=... 等查询参数，SSL 统一使用下面的变量。
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres"
DATABASE_SSL=true
# 可选：需要自定义 CA 时，填写从 Supabase 下载的 PEM 证书的绝对路径。留空时使用 Node 默认信任库，始终校验证书。
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5

# 将来 API 和 PostgreSQL 都直接运行在同一台服务器时：
# DATABASE_URL="postgresql://folinel:URL_ENCODED_PASSWORD@127.0.0.1:5432/folinel"
# DATABASE_SSL=false
# DATABASE_CA_CERT=

# 测试环境使用独立测试库，不会回退到上面的开发库；不填则跳过集成测试。
TEST_DATABASE_URL=
TEST_DATABASE_SSL=true
TEST_DATABASE_CA_CERT=
TEST_DATABASE_POOL_MAX=1

# SMTP：Resend 密码填写 API key。false 强制 STARTTLS，true 使用隐式 TLS（如 465）。
# 密钥只填本地文件或部署环境；实际发送前需验证 whisprea.ink 发信域名。
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=noreply@whisprea.ink
