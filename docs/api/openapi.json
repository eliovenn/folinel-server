{
  "openapi": "3.1.1",
  "info": {
    "title": "Folinel API",
    "version": "0.1.0",
    "description": "邮箱注册、验证和会话。项目接口使用 data/error 包装；原生认证接口保留库契约。浏览器使用同源代理和 HttpOnly Cookie，Flutter 使用 Bearer。POST 必须发送 JSON；携带 Cookie 的 POST 必须带可信 Origin。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Better Auth",
      "description": "Better Auth 1.7.18 原生开放入口"
    }
  ],
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean",
            "default": false,
            "readOnly": true
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "emailVerified",
          "createdAt",
          "updatedAt"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "token": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ipAddress": {
            "type": [
              "string",
              "null"
            ]
          },
          "userAgent": {
            "type": [
              "string",
              "null"
            ]
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "expiresAt",
          "token",
          "createdAt",
          "updatedAt",
          "userId"
        ]
      },
      "NativeAuthError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/NativeAuthError"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "set-auth-token 响应头的签名会话凭据"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-better-auth.session_token",
        "description": "HTTPS HttpOnly Cookie，由浏览器自动管理"
      },
      "developmentCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "仅用于本地 HTTP 开发"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "存活检查",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": "ok",
                          "type": "string"
                        }
                      },
                      "required": [
                        "status"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "邮箱密码注册并发送验证码",
        "security": [],
        "description": "验证前不建立会话。未验证账号再次注册会替换密码及申请 ID；已验证账号返回模拟成功但不修改账号、不发信。请保存当前 registrationId。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "description": "邮箱：去除首尾空白、转小写后校验邮箱格式和 254 字符上限。"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "registrationId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "expiresIn": {
                          "type": "integer",
                          "const": 600,
                          "description": "验证码有效秒数"
                        },
                        "resendAfter": {
                          "type": "integer",
                          "const": 60,
                          "description": "邮箱发送冷却秒数"
                        }
                      },
                      "required": [
                        "registrationId",
                        "expiresIn",
                        "resendAfter"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入、JSON、注册申请或验证码无效/过期。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "域名被禁用、邮箱未验证、来源不可信或验证码尝试次数用完。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "项目 JSON 请求正文超过 1 MiB。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "POST 必须使用 application/json。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "请求超限；Retry-After 为至少等待的秒数。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "秒"
              }
            }
          },
          "500": {
            "description": "服务暂时不可用；响应不包含内部异常。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "邮件服务暂时不可用；本次注册/重发已回滚。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/resend": {
      "post": {
        "operationId": "resendRegistration",
        "summary": "重发当前注册申请验证码",
        "security": [],
        "description": "当前邮箱和 registrationId 必须匹配；新验证码轮换旧验证码。发送失败保留上一枚尚未过期的验证码。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "description": "邮箱：去除首尾空白、转小写后校验邮箱格式和 254 字符上限。"
                  },
                  "registrationId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "required": [
                  "email",
                  "registrationId"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "expiresIn": {
                          "type": "integer",
                          "const": 600,
                          "description": "验证码有效秒数"
                        },
                        "resendAfter": {
                          "type": "integer",
                          "const": 60,
                          "description": "邮箱发送冷却秒数"
                        }
                      },
                      "required": [
                        "expiresIn",
                        "resendAfter"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入、JSON、注册申请或验证码无效/过期。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "域名被禁用、邮箱未验证、来源不可信或验证码尝试次数用完。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "项目 JSON 请求正文超过 1 MiB。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "POST 必须使用 application/json。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "请求超限；Retry-After 为至少等待的秒数。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "秒"
              }
            }
          },
          "500": {
            "description": "服务暂时不可用；响应不包含内部异常。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "邮件服务暂时不可用；本次注册/重发已回滚。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify-registration": {
      "post": {
        "operationId": "verifyRegistration",
        "summary": "验证当前注册申请并自动建立会话",
        "security": [],
        "description": "消费六位验证码；最多五次错误。成功后直接进入应用，无需再次输入密码。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "description": "邮箱：去除首尾空白、转小写后校验邮箱格式和 254 字符上限。"
                  },
                  "registrationId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "otp": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  }
                },
                "required": [
                  "email",
                  "registrationId",
                  "otp"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "boolean",
                          "description": "Indicates if the verification was successful",
                          "enum": [
                            true
                          ]
                        },
                        "token": {
                          "type": "string",
                          "description": "库返回的会话 token；客户端优先保存 set-auth-token 响应头。"
                        },
                        "user": {
                          "$ref": "#/components/schemas/User"
                        }
                      },
                      "required": [
                        "status",
                        "token",
                        "user"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "浏览器会话：HttpOnly、SameSite=Lax；HTTPS 使用 Secure 及 __Secure- 前缀。",
                "schema": {
                  "type": "string"
                }
              },
              "set-auth-token": {
                "description": "Flutter 保存此签名会话凭据，后续使用 Authorization: Bearer。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "输入、JSON、注册申请或验证码无效/过期。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "域名被禁用、邮箱未验证、来源不可信或验证码尝试次数用完。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "项目 JSON 请求正文超过 1 MiB。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "POST 必须使用 application/json。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "请求超限；Retry-After 为至少等待的秒数。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "秒"
              }
            }
          },
          "500": {
            "description": "服务暂时不可用；响应不包含内部异常。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "currentUser",
        "summary": "读取已验证的当前用户",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          },
          {
            "developmentCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "name": {
                          "type": "string"
                        },
                        "emailVerified": {
                          "type": "boolean",
                          "const": true
                        }
                      },
                      "required": [
                        "id",
                        "email",
                        "name",
                        "emailVerified"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录或邮箱密码错误。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务暂时不可用；响应不包含内部异常。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-in/email": {
      "post": {
        "tags": [
          "Better Auth"
        ],
        "description": "保持 Better Auth 原生成功响应。原生错误为 { code, message }；项目前置来源/限流/格式检查错误为 { error: { code, message } }。所有错误使用固定安全文案。",
        "operationId": "signInEmail",
        "security": [],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "Email of the user"
                  },
                  "password": {
                    "type": "string",
                    "description": "Password of the user"
                  },
                  "callbackURL": {
                    "type": "string",
                    "description": "Callback URL to use as a redirect for email verification"
                  },
                  "rememberMe": {
                    "type": "boolean",
                    "description": "If this is false, the session will not be remembered. Default is `true`."
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "redirect": {
                      "type": "boolean",
                      "description": "传入可信 callbackURL 时为 true。"
                    },
                    "token": {
                      "type": "string",
                      "description": "Session token"
                    },
                    "url": {
                      "type": "string",
                      "description": "仅传入 callbackURL 时返回。"
                    },
                    "user": {
                      "type": "object",
                      "$ref": "#/components/schemas/User"
                    }
                  },
                  "required": [
                    "redirect",
                    "token",
                    "user"
                  ]
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "浏览器会话：HttpOnly、SameSite=Lax；HTTPS 使用 Secure 及 __Secure- 前缀。",
                "schema": {
                  "type": "string"
                }
              },
              "set-auth-token": {
                "description": "Flutter 保存此签名会话凭据，后续使用 Authorization: Bearer。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "输入、JSON、注册申请或验证码无效/过期。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/NativeAuthError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录或邮箱密码错误。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/NativeAuthError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "域名被禁用、邮箱未验证、来源不可信或验证码尝试次数用完。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/NativeAuthError"
                    }
                  ]
                }
              }
            }
          },
          "415": {
            "description": "POST 必须使用 application/json。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/NativeAuthError"
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "请求超限；Retry-After 为至少等待的秒数。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/NativeAuthError"
                    }
                  ]
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "秒"
              }
            }
          },
          "500": {
            "description": "服务暂时不可用；响应不包含内部异常。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/NativeAuthError"
                    }
                  ]
